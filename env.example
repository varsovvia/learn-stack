# Caddy Configuration
ACME_EMAIL=admin@example.com
PROD_DOMAIN=example.com

# Service Ports
WEB_PORT=3000
API_PORT=8000
ML_PORT=9000

# Resource Limits (Production)
WEB_CPU=0.5
WEB_MEM=512M
API_CPU=0.5
API_MEM=512M
ML_CPU=1.0
ML_MEM=1G

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Development overrides
NODE_ENV=development
